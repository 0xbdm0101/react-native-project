    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@lingui/cli": "^4.14.1",
    "@lingui/macro": "^4.14.1",
    "@types/react": "~19.1.0",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~5.9.2"
  }
}
