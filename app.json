{
  "expo": {
    "name": "大苹果iot",
    "slug": "my-app-rn",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "my-app-rn",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.my-app-rn",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "允许 $(PRODUCT_NAME) 使用相机扫描二维码和条形码",
        "NSBluetoothAlwaysUsageDescription": "允许 $(PRODUCT_NAME) 使用蓝牙连接设备",
        "NSBluetoothPeripheralUsageDescription": "允许 $(PRODUCT_NAME) 使用蓝牙连接设备",
        "NSLocationWhenInUseUsageDescription": "允许 $(PRODUCT_NAME) 使用位置信息扫描WiFi网络",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "允许 $(PRODUCT_NAME) 使用位置信息扫描WiFi网络"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.myapprn",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "INTERNET",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 $(PRODUCT_NAME) 使用相机扫描二维码和条形码"
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "允许 $(PRODUCT_NAME) 使用蓝牙连接设备"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee56e2de-948d-44bf-91f7-4f7e237b6d76"
      }
    }
  }
}
